options:
  parameters:
    author: Ettus Research; LibreSDR UCA configuration
    catch_exceptions: 'True'
    comment: B210 OTA calibration pilot for the LibreSDR UCA.
    description: 50 kHz complex pilot kept away from receiver DC for narrow translated filtering.
    generate_options: qt_gui
    generator_class_name: PythonQtGuiGenerator
    generator_module: gnuradio.grc.workflows.python_qt_gui
    id: run_DoA_transmitter
    output_language: python
    run: 'True'
    run_command: '{python} -u {filename}'
    title: B210 OTA Calibration Tone
  states:
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: input_variables
  id: variable_struct
  parameters:
    comment: "Calibration pilot settings. CenterFreq must match the LibreSDR LO; ToneFreq must match pilot_offset in the receiver graph."
    field0: ToneFreq
    field1: SampleRate
    field2: CenterFreq
    field3: TxAddr
    field4: Gain
    field5: ''
    field6: ''
    field7: ''
    field8: ''
    field9: ''
    field10: ''
    field11: ''
    field12: ''
    field13: ''
    field14: ''
    field15: ''
    field16: ''
    field17: ''
    field18: ''
    field19: ''
    value0: 50e3
    value1: 1e6
    value2: 920.9e6
    value3: '"serial=310C4AE"'
    value4: '89'
    value5: '0'
    value6: '0'
    value7: '0'
    value8: '0'
    value9: '0'
    value10: '0'
    value11: '0'
    value12: '0'
    value13: '0'
    value14: '0'
    value15: '0'
    value16: '0'
    value17: '0'
    value18: '0'
    value19: '0'
  states:
    coordinate: [8, 145]
    rotation: 0
    state: enabled

- name: analog_sig_source_x_0
  id: analog_sig_source_x
  parameters:
    amp: '1'
    freq: input_variables.ToneFreq
    offset: '0'
    phase: '0'
    samp_rate: input_variables.SampleRate
    type: complex
    waveform: analog.GR_SIN_WAVE
  states:
    coordinate: [328, 120]
    rotation: 0
    state: enabled

- name: qtgui_time_sink_x_0
  id: qtgui_time_sink_x
  parameters:
    autoscale: 'True'
    axislabels: 'True'
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'False'
    name: '"Calibration pilot baseband"'
    nconnections: '1'
    size: '1024'
    srate: input_variables.SampleRate
    stemplot: 'False'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_level: '0.0'
    type: complex
    update_time: '0.10'
    ylabel: Amplitude
    ymax: '1'
    ymin: '-1'
    yunit: '""'
  states:
    coordinate: [616, 296]
    rotation: 0
    state: enabled

- name: uhd_usrp_sink_0
  id: uhd_usrp_sink
  parameters:
    ant0: '"TX/RX"'
    bw0: '0'
    center_freq0: input_variables.CenterFreq
    clock_rate: '0.0'
    clock_source0: internal
    dev_addr: input_variables.TxAddr
    dev_args: '""'
    gain0: input_variables.Gain
    gain_type0: default
    len_tag_name: ''
    lo_export0: 'False'
    lo_source0: internal
    nchan: '1'
    num_mboards: '1'
    otw: ''
    samp_rate: input_variables.SampleRate
    show_lo_controls: 'False'
    start_time: '-1.0'
    stream_args: ''
    stream_chans: '[]'
    sync: sync
    time_source0: ''
    type: fc32
  states:
    coordinate: [616, 92]
    rotation: 0
    state: enabled

connections:
- [analog_sig_source_x_0, '0', qtgui_time_sink_x_0, '0']
- [analog_sig_source_x_0, '0', uhd_usrp_sink_0, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
