options:
  parameters:
    alias: ''
    author: gr-doa LibreSDR research port
    catch_exceptions: 'True'
    comment: Four-channel LibreSDR UCA MUSIC with a fixed calibration beacon and a
      separate movable target.
    copyright: null
    description: Continuously tracked +50 kHz calibration pilot and independently
      filtered +150 kHz target for live direction finding.
    gen_linking: dynamic
    generate_options: qt_gui
    generator_class_name: PythonQtGuiGenerator
    generator_module: gnuradio.grc.workflows.python_qt_gui
    hier_block_src_path: null
    id: run_MUSIC_uca_live_cal
    max_nouts: '0'
    output_language: python
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    thread_safe_setters: ''
    title: LibreSDR UCA MUSIC - Live OTA Calibration
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: array_radius
  id: variable
  parameters:
    comment: Physical UCA radius in metres from 162.63 mm adjacent chord spacing
    value: 0.16263 / (2**0.5)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1168, 16]
    rotation: 0
    state: enabled
- name: calibration_file
  id: variable
  parameters:
    comment: Diagnostic copy of frozen phase coefficients
    value: '"/tmp/gr-doa-uca-phase-offsets.cfg"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1296, 96]
    rotation: 0
    state: enabled
- name: calibration_samples
  id: variable
  parameters:
    comment: Filtered pilot samples used for complex averaging/coherence
    value: 2**12
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [656, 96]
    rotation: 0
    state: enabled
- name: calibration_skip
  id: variable
  parameters:
    comment: Filtered samples skipped before calibration
    value: 2**11
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 96.0]
    rotation: 0
    state: enabled
- name: center_freq
  id: variable
  parameters:
    comment: LibreSDR and B210 RF centre frequency
    value: int(700e6)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 16]
    rotation: 0
    state: enabled
- name: cfo_agreement_tolerance_hz
  id: variable
  parameters:
    comment: Maximum accepted disagreement between ch2/ch0 and ch3/ch0
    value: '10.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [528, 176]
    rotation: 0
    state: enabled
- name: cfo_estimation_samples
  id: variable
  parameters:
    comment: Raw OTA pilot samples in each Bravo-vs-Alpha CFO window
    value: 2**16
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [176, 176]
    rotation: 0
    state: enabled
- name: cfo_max_abs_hz
  id: variable
  parameters:
    comment: Reject implausibly large Bravo-minus-Alpha CFO estimates
    value: '20000.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 176]
    rotation: 0
    state: enabled
- name: cfo_max_refinement_rounds
  id: variable
  parameters:
    comment: Maximum closed-loop residual correction attempts before rejecting and
      retrying
    value: '3'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 232]
    rotation: 0
    state: enabled
- name: cfo_min_coherence
  id: variable
  parameters:
    comment: Minimum narrow-pilot coherence for coarse and residual CFO estimates
    value: '0.90'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [880, 176]
    rotation: 0
    state: enabled
- name: cfo_residual_tolerance_hz
  id: variable
  parameters:
    comment: Maximum averaged post-correction residual CFO allowed before cfo_locked
    value: '1.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [528, 232]
    rotation: 0
    state: enabled
- name: cfo_retry_delay_samples
  id: variable
  parameters:
    comment: Raw samples to pass before retrying a rejected CFO window
    value: 2**16
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [352, 176]
    rotation: 0
    state: enabled
- name: cfo_settling_samples
  id: variable
  parameters:
    comment: Five-second IIO/RF/PLL settling before cross-SDR CFO estimation
    value: int(5 * samp_rate)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 176]
    rotation: 0
    state: enabled
- name: cfo_validation_settling_samples
  id: variable
  parameters:
    comment: Corrected raw samples to settle before each residual validation window
    value: 2**12
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [176, 232]
    rotation: 0
    state: enabled
- name: element0_bearing
  id: variable
  parameters:
    comment: 192.168.4.1 RX1 top-right element
    value: '315.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [272, 96]
    rotation: 0
    state: enabled
- name: element_bearing_step
  id: variable
  parameters:
    comment: Physical stream order proceeds counter-clockwise around the UCA
    value: '90.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 96]
    rotation: 0
    state: enabled
- name: norm_radius
  id: variable
  parameters:
    comment: Frequency-derived UCA radius in wavelengths
    value: array_radius * pilot_rf / 299792458.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1424, 16]
    rotation: 0
    state: enabled
- name: num_elements
  id: variable
  parameters:
    comment: Two RX channels per LibreSDR
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 96]
    rotation: 0
    state: enabled
- name: num_targets
  id: variable
  parameters:
    comment: Known number of narrowband sources
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1040, 96]
    rotation: 0
    state: enabled
- name: overlap_size
  id: variable
  parameters:
    comment: Covariance snapshot overlap
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [912, 96]
    rotation: 0
    state: enabled
- name: pilot_bearing
  id: variable
  parameters:
    comment: Source bearing from array centre towards the B210 pilot
    value: '180'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [160, 96.0]
    rotation: 0
    state: enabled
- name: pilot_decim
  id: variable
  parameters:
    comment: Identical decimation in all four pilot filters
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [656, 16]
    rotation: 0
    state: enabled
- name: pilot_offset
  id: variable
  parameters:
    comment: B210 complex tone offset from centre frequency
    value: 50e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [528, 16]
    rotation: 0
    state: enabled
- name: pilot_passband
  id: variable
  parameters:
    comment: Low-pass cutoff after translating the pilot to DC
    value: 10e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [784, 16]
    rotation: 0
    state: enabled
- name: pilot_rf
  id: variable
  parameters:
    comment: Actual RF of the fixed calibration pilot
    value: center_freq + pilot_offset
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1296, 16]
    rotation: 0
    state: enabled
- name: pilot_transition
  id: variable
  parameters:
    comment: Pilot LPF transition width
    value: 10e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [912, 16]
    rotation: 0
    state: enabled
- name: proc_rate
  id: variable
  parameters:
    comment: Sample rate after pilot filtering/decimation
    value: samp_rate / pilot_decim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1040, 16]
    rotation: 0
    state: enabled
- name: pspectrum_len
  id: variable
  parameters:
    comment: 720 bins gives 0.5 degree scan spacing
    value: '720'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1168, 96]
    rotation: 0
    state: enabled
- name: rf_bandwidth
  id: variable
  parameters:
    comment: Requested AD9361 RF bandwidth
    value: int(2.8e6)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [272, 16]
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable
  parameters:
    comment: Same manual gain on all four channels
    value: '40'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 16]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: LibreSDR complex sample rate
    value: int(525e3)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [144, 16]
    rotation: 0
    state: enabled
- name: snapshot_size
  id: variable
  parameters:
    comment: Samples per MUSIC covariance estimate
    value: 2**13
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [784, 96]
    rotation: 0
    state: enabled
- name: target_norm_radius
  id: variable
  parameters:
    comment: UCA radius in wavelengths at the target RF, used by MUSIC
    value: array_radius * target_rf / 299792458.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1424, 64]
    rotation: 0
    state: enabled
- name: target_offset
  id: variable
  parameters:
    comment: Movable B210 TX/RX1 target offset from centre frequency
    value: 150e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [528, 64]
    rotation: 0
    state: enabled
- name: target_rf
  id: variable
  parameters:
    comment: Actual RF of the direction-finding target
    value: center_freq + target_offset
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1296, 64]
    rotation: 0
    state: enabled
- name: pps_sync_after_start
  id: snippet
  parameters:
    code: doa.arm_libresdr_pps_sync(('ip:192.168.4.1', 'ip:192.168.5.1'))
    priority: '0'
    section: main_after_start
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 288]
    rotation: 0
    state: enabled
- name: alpha_internal_phase_display
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
