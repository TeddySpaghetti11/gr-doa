- name: alpha_internal_phase_estimator
  id: doa_phase_offset_est
  parameters:
    affinity: ''
    alias: ''
    comment: Alpha-only direct IIO phase diagnostic; input 0 is RX1 and input 1 is
      RX2.
    maxoutbuf: '0'
    minoutbuf: '0'
    n_skip_ahead: calibration_skip * pilot_decim
    num_inputs: '2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [584, 920]
    rotation: 0
    state: enabled
